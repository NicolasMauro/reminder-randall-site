<% content_for :head do %>
  <title>Reminder Randall — Stop missing things</title>
  <meta name="description" content="Randall blasts you across your preferred channels until you tell him you're going or you have to cancel. Slack, iMessage, email, whatever floats your boat. No bot ever joins your calls.">
  <meta property="og:title" content="Reminder Randall — Stop missing things">
  <meta property="og:description" content="Blasts you across your preferred channels until you tell him you're going or you have to cancel. No bot ever joins your calls.">
  <meta property="og:type" content="website">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Nunito+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --paper: #f5f1ec;
      --ink: #102c4b;
      --muted: #5c7186;
      --blue: #1f5c9a;
      --teal: #149ca3;
      --amber: #e5992e;
      --accent: #e25a24;
      --accent-hover: #c94c1c;
    }
    * { box-sizing: border-box; }
    html, body {
      margin: 0; height: 100%; background: var(--paper); color: var(--ink);
      font-family: "Nunito Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }

    .brand {
      position: fixed; top: 24px; left: 28px;
      display: flex; align-items: center; gap: 8px;
      font-family: "Fredoka", sans-serif;
      font-weight: 700; font-size: 18px; letter-spacing: -0.02em; text-decoration: none; color: var(--blue);
    }
    .brand .glove { font-size: 20px; line-height: 1; }

    .stage {
      min-height: 100svh; min-height: 100vh;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 100px 24px 48px;
    }

    .mascot { margin: 0 0 20px; }
    .mascot img {
      display: block; width: min(360px, 70vw); height: auto; margin: 0 auto;
      border-radius: 24px; box-shadow: 0 20px 34px -14px rgba(16,44,75,.32);
    }

    h1.statement {
      font-family: "Fredoka", sans-serif;
      font-weight: 600; letter-spacing: -0.01em; line-height: 1.18;
      font-size: clamp(28px, 5vw, 48px);
      max-width: 18ch; margin: 0 0 22px;
    }
    h1.statement .line { display: block; }
    .word {
      display: block; color: var(--teal); font-weight: 600;
      transition: opacity .22s ease, transform .22s ease;
    }
    .word.swap { opacity: 0; transform: translateY(8px); }

    .sub { color: var(--muted); font-size: 18px; max-width: 42ch; margin: 0 0 30px; }

    .kicker {
      font-family: "Fredoka", sans-serif;
      color: var(--teal); font-weight: 600; font-size: 15px; margin: 0 0 12px;
    }
    .story { color: var(--ink); font-size: 17px; line-height: 1.65; max-width: 54ch; margin: 0 0 34px; }

    .btn {
      display: inline-block; text-decoration: none; cursor: pointer;
      font-family: "Fredoka", sans-serif; font-weight: 600; font-size: 17px;
      padding: 13px 28px; border-radius: 999px; white-space: nowrap;
      background: var(--accent); color: #fff;
      transition: background .15s ease, transform .06s ease;
    }
    .btn:hover { background: var(--amber); }
    .btn:active { transform: translateY(1px); }

    .note { color: var(--muted); font-size: 13.5px; margin: 18px 0 0; }

    @media (max-width: 480px) {
      .brand { top: 18px; left: 18px; }
    }
  </style>
<% end %>

<a class="brand" href="https://github.com/NicolasMauro/reminder-randall"><span class="glove">🥊</span>Reminder Randall</a>

<div class="stage">
  <div class="mascot">
    <img src="/mascot.svg" alt="Reminder Randall, a claymation-style character in glasses, standing next to a tall stack of reminder papers">
  </div>

  <h1 class="statement"><span class="line">Stop missing</span><span class="word" id="word">meetings</span></h1>

  <p class="sub">Randall blasts you across your preferred channels until you tell him you're going or you have to cancel. Slack, iMessage, email, whatever floats your boat.</p>

  <p class="kicker">What Randall is designed for</p>
  <p class="story">I have meetings every day, and not all of them are on the same calendar — and not all of them are related to the same business, or have any correlation at all. Sometimes I'm double-booked, or deep in work on something unrelated to the first task, and I miss something. Missing something always feels shitty, so I designed an idiot-proof reminder system for myself. Think of the shaking bed alarm clock, but for people with ADHD. Now I have Randall to remind me aggressively of upcoming engagements — dial his aggressiveness up or down as you see fit.</p>

  <a class="btn" href="https://github.com/NicolasMauro/reminder-randall">Get Randall</a>
  <p class="note">MIT licensed · Open source</p>
</div>

<script>
  (function () {
    var words = [
      "meetings", "birthdays", "doctor appointments", "deadlines", "workouts",
      "flights", "calls", "standups", "therapy sessions", "anniversaries",
      "school pickups", "bill payments", "oil changes", "game nights", "dinner reservations",
      "court dates", "parent-teacher conferences", "job interviews", "follow-ups", "coffee chats"
    ];
    var el = document.getElementById("word");
    var i = 0;
    setInterval(function () {
      el.classList.add("swap");
      setTimeout(function () {
        i = (i + 1) % words.length;
        el.textContent = words[i];
        el.classList.remove("swap");
      }, 220);
    }, 1800);
  })();
</script>
